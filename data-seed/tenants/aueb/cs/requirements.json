        "el": "Εγγραφή τουλάχιστον 8 εξάμηνα."
      },
      "params": {}
    },
    {
      "id": "level1-all-mandatory",
      "kind": "ALL_MANDATORY",
      "title": {
        "el": "Επίπεδο 1: υποχρεωτικά μαθήματα πυρήνα"
      },
      "description": {
        "el": "Επιτυχία σε και τα 22 υποχρεωτικά μαθήματα πυρήνα (15 Πληροφορικής, 5 Μαθηματικών, 2 Οικονομικών & Διοικητικών Επιστημών)."
      },
      "params": {
        "level": "CORE_MANDATORY"
      }
    },
    {
      "id": "level2-min-courses",
      "kind": "MIN_COURSES_BY_LEVEL",
      "title": {
        "el": "Επίπεδο 2: μαθήματα επιλογής πυρήνα"
      },
      "description": {
        "el": "Επιτυχία σε τουλάχιστον 4 μαθήματα επιλογής πυρήνα (ΕΠ) από τα 10 διαθέσιμα."
      },
      "params": {
        "level": "CORE_ELECTIVE",
        "min": 4
      }
    },
    {
      "id": "level3-ects",
      "kind": "ECTS_FROM_LEVELS",
      "title": {
        "el": "Επίπεδο 3: ECTS από ΕΠ + Ε"
      },
      "description": {
        "el": "Συγκέντρωση τουλάχιστον 64 ECTS από μαθήματα ΕΠ και Ε μαζί."
      },
      "params": {
        "levels": [
          "CORE_ELECTIVE",
          "ELECTIVE"
        ],
        "min": 64
      }
    },
    {
      "id": "total-ects",
      "kind": "TOTAL_ECTS",
      "title": {
        "el": "Επίπεδο 4 (σύνολο): ECTS"
      },
      "description": {
        "el": "Τουλάχιστον 240 ECTS συνολικά από όλα τα επίπεδα."
      },
      "params": {
        "min": 240
      }
    },
    {
      "id": "language-certificate",
      "kind": "FREE_TEXT",
      "title": {
        "el": "Γλωσσομάθεια"
      },
      "description": {
        "el": "Πιστοποιητικό Γ2 σε Αγγλική, Γερμανική ή Γαλλική (ή επιτυχία στο αντίστοιχο γλωσσικό μάθημα IV)."
      },
      "params": {}
    },
    {
      "id": "cycles",
      "kind": "CYCLES",
      "title": {
        "el": "Κύκλοι σπουδών (προαιρετικοί)"
      },
      "description": {
        "el": "Οι 8 κύκλοι σπουδών είναι προαιρετικοί και αναγράφονται στο πτυχίο αν ολοκληρωθούν. Ολοκλήρωση κύκλου: τουλάχιστον 5 από τα μαθήματα του κύκλου. Ένα μάθημα δεν μπορεί να μετρήσει για δύο κύκλους."
      },
      "params": {
        "minCourses": 5,
        "exclusive": true,
        "optional": true
      }
    },
    {
      "id": "grade",
      "kind": "FREE_TEXT",
      "title": {
        "el": "Βαθμός πτυχίου"
      },
      "description": {
        "el": "Αστάθμητος μέσος όρος όλων των μαθημάτων επιτυχίας. Χαρακτηρισμός: 8,51–10,00 Άριστα · 6,51–8,50 Λίαν Καλώς · 5,00–6,50 Καλώς."
      },
      "params": {
        "classification": [
          {
            "from": 8.51,
            "to": 10.0,
            "label": "Άριστα"
          },
          {
            "from": 6.51,
            "to": 8.5,
            "label": "Λίαν Καλώς"
          },
          {
            "from": 5.0,
            "to": 6.5,
            "label": "Καλώς"
          }
        ]
      }
    },
    {
      "id": "max-duration",
      "kind": "FREE_TEXT",
      "title": {
        "el": "Ανώτατη διάρκεια φοίτησης"
      },
      "description": {
        "el": "8 κανονικά εξάμηνα + 4 επιπλέον = 12 εξάμηνα (Ν. 4957/2022). Μετά τη λήξη, έκδοση πράξης διαγραφής."
      },
      "params": {
        "regularSemesters": 8,
        "extraSemesters": 4
      }
    },
    {
      "id": "grade-cancellation",
      "kind": "FREE_TEXT",
      "title": {
        "el": "Ακύρωση βαθμολογίας"
      },
      "description": {
        "el": "Έως 4 φορές (10% των απαιτούμενων μαθημάτων), εντός 2 ετών από την εξέταση."
      },
      "params": {}
    },
    {
      "id": "exemptions",
      "kind": "FREE_TEXT",
      "title": {
        "el": "Απαλλαγή μαθημάτων (κατατακτήριοι/μεταγραφές)"
      },
      "description": {
        "el": "Έως 80 ECTS απαλλαγής, χωρίς βαθμό — δεν επηρεάζει βαθμό πτυχίου."
      },
      "params": {
        "maxEcts": 80
      }
    },
    {
      "id": "max-ects-per-semester",
      "kind": "FREE_TEXT",
      "title": {
        "el": "Ανώτατο ECTS ανά εξάμηνο"
      },
      "description": {
        "el": "1ο έτος εγγραφής: 38 · 2ο έτος: 46 · 3ο έτος: 54 · 4ο έτος και άνω: 60. Σύσταση: μέγιστο 6 μαθήματα ανά εξάμηνο λόγω υψηλών απαιτήσεων."
      },
      "params": {
        "byYear": {
          "1": 38,
          "2": 46,
          "3": 54,
          "4+": 60
        },
        "recommendedMaxCourses": 6
      }
    }
  ],
