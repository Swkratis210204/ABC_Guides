{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:calendar",
  "title": "Academic calendar for one year (university/calendar/YYYY-YYYY.json)",
  "type": "object",
  "required": ["academic_year", "terms"],
  "additionalProperties": false,
  "properties": {
    "academic_year": { "$ref": "urn:schema:common#/$defs/academic_year" },
    "terms": {
      "description": "The two semesters of the year: semester 1 is the winter semester (October to January) and semester 2 is the spring semester (February to June). Write exactly one of each.",
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "required": ["id", "name", "semester", "start", "end"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "semester": { "description": "1 for the winter semester (October to January), 2 for the spring semester (February to June)", "enum": [1, 2] },
          "start": { "$ref": "urn:schema:common#/$defs/date" },
          "end": { "$ref": "urn:schema:common#/$defs/date" }
        }
      }
    },
    "exam_periods": {
      "description": "Exam sessions",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "type", "start", "end"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "type": { "description": "regular (the normal exams at the end of a term) or resit (the September revision exams for students who have not passed)", "enum": ["regular", "resit"] },
          "term": { "description": "The id of the term these exams belong to (optional)", "$ref": "urn:schema:common#/$defs/id" },
          "start": { "$ref": "urn:schema:common#/$defs/date" },
          "end": { "$ref": "urn:schema:common#/$defs/date" }
        }
      }
    },
    "holidays": {
      "description": "Holidays and breaks. For a single day, leave out the end date.",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "start"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "start": { "$ref": "urn:schema:common#/$defs/date" },
          "end": { "$ref": "urn:schema:common#/$defs/date" },
          "kind": { "description": "One of: public_holiday, break, other", "enum": ["public_holiday", "break", "other"] }
        }
      }
    }
  }
}
