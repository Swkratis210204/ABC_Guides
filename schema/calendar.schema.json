{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:calendar",
  "title": "Academic calendar for one year (university/calendar/YYYY-YYYY.json)",
  "type": "object",
  "required": ["academic_year", "terms"],
  "additionalProperties": false,
  "properties": {
    "academic_year": { "$ref": "urn:schema:common#/$defs/academic_year" },
    "terms": {
      "description": "The teaching periods (usually a winter and a spring semester)",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "start", "end"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "start": { "$ref": "urn:schema:common#/$defs/date" },
          "end": { "$ref": "urn:schema:common#/$defs/date" }
        }
      }
    },
    "exam_periods": {
      "description": "Exam sessions",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "start", "end"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "term": { "description": "The id of the term these exams belong to (optional)", "$ref": "urn:schema:common#/$defs/id" },
          "start": { "$ref": "urn:schema:common#/$defs/date" },
          "end": { "$ref": "urn:schema:common#/$defs/date" }
        }
      }
    },
    "holidays": {
      "description": "Holidays and breaks. For a single day, leave out the end date.",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name", "start"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "start": { "$ref": "urn:schema:common#/$defs/date" },
          "end": { "$ref": "urn:schema:common#/$defs/date" },
          "kind": { "description": "One of: public_holiday, break, other", "enum": ["public_holiday", "break", "other"] }
        }
      }
    }
  }
}
