{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:schools",
  "title": "Schools / faculties of the university (university/schools.json)",
  "type": "object",
  "required": ["schools"],
  "additionalProperties": false,
  "properties": {
    "schools": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "website": { "$ref": "urn:schema:common#/$defs/url" }
        }
      }
    }
  }
}
