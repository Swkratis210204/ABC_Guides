{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:degree_requirements",
  "title": "What a student needs to graduate (general/degree_requirements.json)",
  "type": "object",
  "required": ["total_ects", "rules"],
  "additionalProperties": false,
  "properties": {
    "total_ects": { "description": "Total ECTS needed to graduate. Example: 240", "type": "number", "minimum": 1 },
    "min_semesters": { "description": "Minimum number of semesters of study", "type": "integer", "minimum": 1 },
    "rules": {
      "description": "Each requirement, written as a short title and a plain sentence",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "description"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "title": { "$ref": "urn:schema:common#/$defs/text" },
          "description": { "$ref": "urn:schema:common#/$defs/text" }
        }
      }
    }
  }
}
