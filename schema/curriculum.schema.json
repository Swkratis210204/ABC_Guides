{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:curriculum",
  "title": "Curriculum for one academic year (curriculum/YYYY-YYYY.json)",
  "type": "object",
  "required": ["academic_year", "levels", "courses"],
  "additionalProperties": false,
  "properties": {
    "academic_year": { "description": "Must match the file name. Example: 2026-2027", "$ref": "urn:schema:common#/$defs/academic_year" },
    "ects_caps": {
      "description": "Limits on how many ECTS a student may take",
      "type": "object", "additionalProperties": false,
      "properties": {
        "per_semester": { "description": "Maximum ECTS per semester", "type": "number", "minimum": 1 },
        "per_year": { "description": "Maximum ECTS per year", "type": "number", "minimum": 1 }
      }
    },
    "levels": {
      "description": "Kinds of courses, such as mandatory, core elective, elective, free elective",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "short", "name"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "short": { "description": "Short label shown next to a course. Example: UP", "type": "string", "minLength": 1 },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "description": { "$ref": "urn:schema:common#/$defs/text" }
        }
      }
    },
    "cycles": {
      "description": "Study cycles or tracks (optional)",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "name"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:schema:common#/$defs/id" },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "description": { "$ref": "urn:schema:common#/$defs/text" }
        }
      }
    },
    "courses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["code", "name", "level", "ects", "semesters"], "additionalProperties": false,
        "properties": {
          "code": { "description": "The course code, exactly as the university prints it. Example: 3117", "type": "string", "minLength": 1 },
          "name": { "$ref": "urn:schema:common#/$defs/text" },
          "level": { "description": "The id of the level (from the levels list above)", "$ref": "urn:schema:common#/$defs/id" },
          "ects": { "$ref": "urn:schema:common#/$defs/ects" },
          "semesters": {
            "description": "Which semester numbers the course is offered in. Example: [1] or [7, 8]",
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 12 }
          },
          "cycles": {
            "description": "Ids of the cycles this course belongs to (optional)",
            "type": "array", "uniqueItems": true, "items": { "$ref": "urn:schema:common#/$defs/id" }
          },
          "prerequisites": {
            "description": "Codes of courses a student should have passed first (optional)",
            "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
          },
          "instructors": {
            "description": "Ids of the teachers, from faculty.json (optional)",
            "type": "array", "uniqueItems": true, "items": { "$ref": "urn:schema:common#/$defs/id" }
          },
          "language": { "description": "Language of teaching, as a two-letter code. Example: en", "type": "string", "pattern": "^[a-z]{2}$" },
          "description": { "$ref": "urn:schema:common#/$defs/text" },
          "active": { "description": "Write false if the course is no longer offered. Leave out otherwise.", "type": "boolean" }
        }
      }
    }
  }
}
